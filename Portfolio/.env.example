# ==============================================================================
# Sanity CMS Environment Configuration
# ==============================================================================

# Public Sanity Configuration (Safe for client-side bundle)
# Replace with your Sanity Project ID (e.g., pqf64k7z)
NEXT_PUBLIC_SANITY_PROJECT_ID=

# Dataset name (default: production)
NEXT_PUBLIC_SANITY_DATASET=

# API version date (YYYY-MM-DD)
NEXT_PUBLIC_SANITY_API_VERSION=

# Optional: Disable local static data fallback (set to true in production if you want errors rather than fallback)
# DISABLE_SANITY_FALLBACK=false

# ==============================================================================
# Private Server Secrets (DO NOT expose with NEXT_PUBLIC_ prefix!)
# ==============================================================================

# Sanity API Write Token
# Required for running data migration scripts (scripts/migrate.ts)
# Generate from: https://www.sanity.io/manage/project/<projectId>/api#tokens
SANITY_API_WRITE_TOKEN=
