{
  "name": "my-portfolio-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Monorepo for Portfolio (Next.js) and studio-portfolio (Sanity Studio)",
  "workspaces": [
    "Portfolio",
    "studio-portfolio"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=portfolio-web",
    "dev:web": "npm run dev --workspace=portfolio-web",
    "dev:studio": "npm run dev --workspace=portfolio-studio",
    "build": "npm run build --workspace=portfolio-web",
    "build:web": "npm run build --workspace=portfolio-web",
    "build:studio": "npm run build --workspace=portfolio-studio",
    "migrate": "npm run migrate --workspace=portfolio-web",
    "migrate:dry-run": "npm run migrate:dry-run --workspace=portfolio-web"
  },
  "keywords": [
    "portfolio",
    "nextjs",
    "sanity",
    "monorepo"
  ],
  "author": "Moh. Asraful Hasan Asif",
  "license": "UNLICENSED"
}
